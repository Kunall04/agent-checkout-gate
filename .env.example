# Razorpay TEST MODE ONLY. rzp_live_* keys are a non-goal (CLAUDE.md §9).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional. Without it, intent parsing falls back to the deterministic
# structured path and every decision records parser_status="fallback_no_llm".
ANTHROPIC_API_KEY=

# Public base URL used for approval links / Razorpay callbacks.
GATE_BASE_URL=http://127.0.0.1:8000
